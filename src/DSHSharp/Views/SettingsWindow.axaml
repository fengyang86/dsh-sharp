<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DSHSharp.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="760" d:DesignHeight="580"
        x:Class="DSHSharp.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="DSH-Sharp 设置"
        Width="760" Height="580"
        MinWidth="640" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Icon="/Assets/avalonia-logo.ico">

    <Design.DataContext>
        <vm:SettingsViewModel/>
    </Design.DataContext>

    <DockPanel Margin="0">

        <!-- ===== 底部操作栏 ===== -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8"
                    Margin="16,12,16,14">
            <Button Content="恢复默认" Padding="14,6" Command="{Binding RestoreDefaultsCommand}"/>
            <Button Content="保存" Padding="20,6" Command="{Binding SaveCommand}"/>
            <Button Content="取消" Padding="20,6" Command="{Binding CancelCommand}"/>
        </StackPanel>

        <!-- ===== 左侧导航 ===== -->
        <Border DockPanel.Dock="Left" Width="170"
                Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                BorderThickness="0,0,1,0"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
            <ListBox ItemsSource="{Binding Sections}" SelectedItem="{Binding SelectedSection}"
                     Margin="8" Background="Transparent">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" Padding="10,8" FontSize="13"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- ===== 内容区 ===== -->
        <ScrollViewer>
            <StackPanel Margin="20,16,20,16" Spacing="16">

                <!-- ===== 面板：私有 Runtime ===== -->
                <StackPanel IsVisible="{Binding ShowProfiles}" Spacing="14">

                    <Border Padding="12,10" CornerRadius="6" BorderThickness="1"
                            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="DSH 运行时" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding ServiceStatusText}" FontSize="12"
                                       TextWrapping="Wrap" LineHeight="18"/>
                            <TextBlock Text="DSH-Sharp 只运行并连接私有目录中的官方 DSH Runtime。外部服务和源码部署不会被探测、修改或停止。"
                                       FontSize="12" TextWrapping="Wrap" LineHeight="18"
                                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="启动运行时" Padding="12,4" FontSize="12"
                                        Command="{Binding StartServiceCommand}"/>
                                <Button Content="停止运行时" Padding="12,4" FontSize="12"
                                        Command="{Binding StopServiceCommand}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ===== 面板：插件 ===== -->
                <StackPanel IsVisible="{Binding ShowPlugins}" Spacing="12" x:CompileBindings="False">
                    <TextBlock Text="插件" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock Text="这里列出当前 DSH profile 已安装的插件。内置插件由客户端维护，第三方插件可停用或卸载；修改后需重启 DSH 服务生效。"
                               FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                    <ItemsControl ItemsSource="{Binding Plugins}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="10" Margin="0,0,0,8" BorderThickness="1" CornerRadius="4"
                                        BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                        <StackPanel Spacing="3">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Description}" FontSize="12" TextWrapping="Wrap"/>
                                            <StackPanel Orientation="Horizontal" Spacing="2">
                                                <TextBlock Text="版本" FontSize="11"/>
                                                <TextBlock Text="{Binding Version}" FontSize="11"/>
                                                <TextBlock Text="·" FontSize="11"/>
                                                <TextBlock Text="{Binding IsActive, StringFormat=激活：{0}}" FontSize="11"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <ToggleSwitch Command="{Binding $parent[ItemsControl].DataContext.TogglePluginCommand}"
                                                          CommandParameter="{Binding}" IsChecked="{Binding IsActive}"
                                                          OffContent="未激活" OnContent="已激活"
                                                          IsHitTestVisible="{Binding !IsBundled, FallbackValue=True}"
                                                          Focusable="{Binding !IsBundled, FallbackValue=True}"/>
                                            <Button Content="卸载" Command="{Binding $parent[ItemsControl].DataContext.RemovePluginCommand}"
                                                    CommandParameter="{Binding}" IsVisible="{Binding !IsBundled, FallbackValue=True}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="内置会话插件功能" FontWeight="SemiBold" Margin="0,8,0,0"/>
                    <TextBlock Text="这些开关控制 DSH-Sharp 内置会话增强功能；修改后需重启 DSH 服务生效。"
                               FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                    <ToggleSwitch Content="Esc 停止当前会话" IsChecked="{Binding SessionPluginEscStopEnabled}"/>
                    <ToggleSwitch Content="会话右键复制会话 ID" IsChecked="{Binding SessionPluginCopyIdEnabled}"/>
                    <ToggleSwitch Content="工作区右键在资源管理器中打开" IsChecked="{Binding SessionPluginOpenWorkspaceEnabled}"/>
                    <ToggleSwitch Content="托盘最近会话跳转" IsChecked="{Binding SessionPluginTrayNavigationEnabled}"/>
                </StackPanel>

                <!-- ===== 面板：通用 ===== -->
                <StackPanel IsVisible="{Binding ShowGeneral}" Spacing="10">
                    <TextBlock Text="通用" FontSize="16" FontWeight="SemiBold"/>
                    <ToggleSwitch Content="登录时自启动" IsChecked="{Binding AutoStartEnabled}"/>
                    <ToggleSwitch Content="关闭窗口时最小化到托盘" IsChecked="{Binding CloseToTray}"/>
                    <ToggleSwitch Content="启动时最小化到托盘" IsChecked="{Binding StartMinimized}"/>
                    <ToggleSwitch Content="会话完成时弹出通知" IsChecked="{Binding SessionCompleteNotifications}"/>
                    <ToggleSwitch Content="通知附带提示音" IsChecked="{Binding NotificationSoundEnabled}"/>
                    <StackPanel Spacing="6" Margin="0,8,0,0" MaxWidth="260">
                        <TextBlock Text="主题" FontSize="12"/>
                        <ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme}"
                                  HorizontalAlignment="Stretch"/>
                    </StackPanel>
                </StackPanel>

                <!-- ===== 面板：关于 ===== -->
                <StackPanel IsVisible="{Binding ShowAbout}" Spacing="10">
                    <TextBlock Text="版本与更新" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock Text="DSH-Sharp 客户端" FontSize="14" FontWeight="SemiBold" Margin="0,6,0,0"/>
                    <TextBlock Text="{Binding AboutText}" FontSize="13" LineHeight="22" TextWrapping="Wrap"/>
                    <StackPanel Spacing="6" x:CompileBindings="False">
                        <TextBlock Text="{Binding ClientUpdateStatusText}" FontSize="12" TextWrapping="Wrap" LineHeight="18"
                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                        <ProgressBar IsVisible="{Binding ClientUpdateDownloading}"
                                     IsIndeterminate="{Binding ClientUpdateIndeterminate}"
                                     Maximum="100" Value="{Binding ClientUpdatePercent}" Height="4"/>
                        <TextBlock Text="{Binding ClientUpdateError}" FontSize="12" TextWrapping="Wrap"
                                   IsVisible="{Binding ClientUpdateRetryable}"
                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="升级并重启" Padding="14,5"
                                    IsVisible="{Binding ClientUpdateReady}"
                                    Command="{Binding InstallClientUpdateCommand}"/>
                            <Button Content="重试" Padding="14,5"
                                    IsVisible="{Binding ClientUpdateRetryable}"
                                    Command="{Binding RetryClientUpdateCommand}"/>
                            <Button Content="检查客户端更新" Padding="14,5"
                                    Command="{Binding CheckClientUpdateNowCommand}"/>
                        </StackPanel>
                        <ToggleSwitch Content="自动检查客户端更新并预下载升级包"
                                      IsChecked="{Binding ClientUpdateCheckEnabled}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Separator Margin="0,4"/>
                    <TextBlock Text="DSH Runtime" FontSize="14" FontWeight="SemiBold"/>
                    <TextBlock Text="DSH Runtime 由独立 npm 包发布，安装在 DSH-Sharp 私有目录中。客户端与运行时分别发布和更新；运行时更新不会清除私有会话、插件和设置。"
                               FontSize="12" TextWrapping="Wrap" LineHeight="18"
                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                    <TextBlock Text="{Binding VersionInfoText}" FontSize="12" TextWrapping="Wrap" LineHeight="18"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="检查 Runtime 版本" Padding="14,5" Command="{Binding CheckUpdateCommand}"/>
                        <Button Content="更新 Runtime" Padding="14,5" Command="{Binding UpdateServiceCommand}"
                                IsEnabled="{Binding CanUpdateOfficialPackage}"/>
                    </StackPanel>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

    </DockPanel>
</Window>
