<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DSHSharp.ViewModels"
        xmlns:chrome="using:Avalonia.Controls.Chrome"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="680"
        x:Class="DSHSharp.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="DSH-Sharp"
        Width="1000" Height="680"
        MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        ExtendClientAreaToDecorationsHint="True"
        WindowDecorations="BorderOnly">

    <Window.Styles>
        <!-- 自定义标题栏窗口按钮 -->
        <Style Selector="Button.window-btn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style Selector="Button.window-btn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseLowBrush}"/>
        </Style>
        <Style Selector="Button.window-btn.close:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#C42B1C"/>
        </Style>
    </Window.Styles>

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="36,*,Auto">

        <!-- ===== 自定义标题栏（ElementRole=TitleBar 提供拖动） ===== -->
        <Border Grid.Row="0"
                chrome:WindowDecorationProperties.ElementRole="TitleBar"
                Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
                DoubleTapped="TitleBar_OnDoubleTapped">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Grid.Column="0" Margin="12,0" Orientation="Horizontal" Spacing="8"
                            VerticalAlignment="Center">
                    <TextBlock Text="DSH-Sharp" FontSize="13" FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Version}" FontSize="11"
                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="0">
                    <Button Classes="window-btn"
                            chrome:WindowDecorationProperties.ElementRole="User"
                            Click="SettingsButton_OnClick"
                            ToolTip.Tip="设置">
                        <TextBlock Text="&#x2699;" FontSize="15"
                                   Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
                                   VerticalAlignment="Center"/>
                    </Button>
                    <Button Classes="window-btn"
                            chrome:WindowDecorationProperties.ElementRole="User"
                            Click="MinimizeButton_OnClick"
                            ToolTip.Tip="最小化">
                        <Path Data="M 0,0 L 10,0" Stroke="{DynamicResource SystemControlForegroundBaseHighBrush}"
                              StrokeThickness="1.2" VerticalAlignment="Center"/>
                    </Button>
                    <Button x:Name="MaximizeButton" Classes="window-btn"
                            chrome:WindowDecorationProperties.ElementRole="User"
                            Click="MaximizeButton_OnClick"
                            ToolTip.Tip="最大化">
                        <Grid Width="10" Height="10">
                            <Path x:Name="MaximizeIcon" Data="M 0.5,0.5 L 9.5,0.5 L 9.5,9.5 L 0.5,9.5 Z"
                                  Stroke="{DynamicResource SystemControlForegroundBaseHighBrush}"
                                  StrokeThickness="1.2" VerticalAlignment="Center"/>
                            <!-- 还原图标：前后两个重叠方框 -->
                            <Path x:Name="RestoreIcon" IsVisible="False"
                                  Data="M 3,1 L 9,1 L 9,7 L 3,7 Z M 1,3 L 7,3 L 7,9 L 1,9 Z"
                                  Stroke="{DynamicResource SystemControlForegroundBaseHighBrush}"
                                  StrokeThickness="1.2" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                    <Button Classes="window-btn close"
                            chrome:WindowDecorationProperties.ElementRole="User"
                            Click="CloseButton_OnClick"
                            ToolTip.Tip="关闭">
                        <Path Data="M 0,0 L 10,10 M 10,0 L 0,10"
                              Stroke="{DynamicResource SystemControlForegroundBaseHighBrush}"
                              StrokeThickness="1.2" VerticalAlignment="Center"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== DSH WebUI ===== -->
        <Border Grid.Row="1">
            <NativeWebView x:Name="Web"/>
        </Border>

        <!-- ===== 引导页（服务离线时覆盖 WebView） ===== -->
        <Border x:Name="OnboardingPanel" Grid.Row="1" IsVisible="False"
                Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="14" MaxWidth="460"
                        Margin="32">
                <TextBlock Text="未检测到 DSH 服务" FontSize="20" FontWeight="SemiBold"
                           HorizontalAlignment="Center"/>
                <TextBlock x:Name="OnboardingDetailText" TextWrapping="Wrap" TextAlignment="Center"
                           FontSize="13" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                <Border x:Name="PortHintPanel" IsVisible="False" Padding="12,10" CornerRadius="6"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
                    <StackPanel Spacing="8">
                        <TextBlock x:Name="PortHintText" TextWrapping="Wrap" TextAlignment="Center"
                                   FontSize="12"/>
                        <Button x:Name="PortSwitchButton" Content="切换到该地址" Padding="16,5"
                                HorizontalAlignment="Center" Click="PortSwitchButton_OnClick"/>
                    </StackPanel>
                </Border>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                    <Button x:Name="StartServiceButton" Content="启动本地服务" Padding="16,6"
                            Click="StartServiceButton_OnClick"/>
                    <Button Content="重新检测" Padding="16,6" Click="RetryProbeButton_OnClick"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ===== 状态栏 ===== -->
        <Border Grid.Row="2" Padding="12,5"
                Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
            <StackPanel Orientation="Horizontal" Spacing="7">
                <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                         Fill="{Binding ServiceStatusBrush}"/>
                <TextBlock Text="{Binding ServiceStatusText}" FontSize="12"
                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
            </StackPanel>
        </Border>

    </Grid>

</Window>
